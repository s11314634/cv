        .lang-btn {
            border: none;
            background: none;
            padding: 5px 12px;
            border-radius: 15px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.85rem;
            color: var(--light-text);
            transition: all 0.3s ease;
        }

        .lang-btn.active {
            background-color: var(--accent-color);
            color: #ffffff;
        }

        header {
            text-align: center;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 25px;
            margin-bottom: 30px;
            margin-top: 10px;
